# ---------------------------------------------------------------------------
# CineMatch – Beispielkonfiguration. Kopieren nach .env und Werte anpassen.
# ---------------------------------------------------------------------------

APP_NAME=CineMatch
DEBUG=false

# Admin-Dashboard (/admin) – HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-durch-ein-langes-passwort-ersetzen

# Reverse Proxy (Nginx/Caddy/Traefik): X-Forwarded-For auswerten
TRUST_FORWARDED_FOR=true

# CORS - erlaubte Origins (Komma-getrennt, * fuer alle)
# In Produktion auf spezifische Domain(s) einschraenken, z.B.:
# CORS_ORIGINS=https://watch.kokohome.de,https://www.kokohome.de
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# TMDB
# ---------------------------------------------------------------------------
# API-Key (v3) ODER Read Access Token (v4) – einer von beiden genuegt.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_REGION=DE
TMDB_LANGUAGE=de-DE
TMDB_CACHE_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Haushalt & Quiz
# ---------------------------------------------------------------------------
# Verfuegbar: netflix, prime, disney, appletv, paramount, crunchyroll
HOUSEHOLD_DEFAULT_PROVIDERS=netflix,prime
QUIZ_MAX_ANSWERS=20
MAX_AVATAR_BYTES=3145728

# Optional: Pfade (im Container nicht aendern)
# DATA_DIR=/app/data
# STATIC_DIR=/app/static
